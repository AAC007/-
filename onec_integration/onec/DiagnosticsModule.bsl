// Диагностический модуль обследования метаданных 1С:УТ.
// Не создает документы и не изменяет данные.

Функция СформироватьДиагностическийОтчет() Экспорт
	Отчет = Новый Структура;
	Отчет.Вставить("generated_at", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"));
	Отчет.Вставить("platform_version", ВерсияПриложения());
	Отчет.Вставить("configuration", Метаданные.Синоним);
	Отчет.Вставить("configuration_name", Метаданные.Имя);
	Отчет.Вставить("configuration_version", Метаданные.Версия);
	Отчет.Вставить("warehouses", СписокСправочника("Склады"));
	Отчет.Вставить("organizations", СписокСправочника("Организации"));
	Отчет.Вставить("documents", НайтиДокументы());
	Отчет.Вставить("accumulation_registers", НайтиРегистрыНакопления());
	Отчет.Вставить("roles", СписокРолей());
	Возврат Отчет;
КонецФункции

Функция НайтиДокументы()
	Результат = Новый Массив;
	Для Каждого ДокументМетаданные Из Метаданные.Документы Цикл
		ИмяПоиска = НРег(ДокументМетаданные.Имя + " " + ДокументМетаданные.Синоним);
		Если СтрНайти(ИмяПоиска, "комплект") > 0 Или СтрНайти(ИмяПоиска, "перемещ") > 0 Тогда
			Результат.Добавить(ОписаниеОбъектаМетаданных(ДокументМетаданные));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиРегистрыНакопления()
	Результат = Новый Массив;
	Для Каждого РегистрМетаданные Из Метаданные.РегистрыНакопления Цикл
		ИмяПоиска = НРег(РегистрМетаданные.Имя + " " + РегистрМетаданные.Синоним);
		Если СтрНайти(ИмяПоиска, "товары") > 0
			Или СтрНайти(ИмяПоиска, "склад") > 0
			Или СтрНайти(ИмяПоиска, "остат") > 0
			Или СтрНайти(ИмяПоиска, "резерв") > 0
			Или СтрНайти(ИмяПоиска, "партии") > 0 Тогда
			Результат.Добавить(ОписаниеОбъектаМетаданных(РегистрМетаданные));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОписаниеОбъектаМетаданных(ОбъектМетаданные)
	Описание = Новый Структура;
	Описание.Вставить("name", ОбъектМетаданные.Имя);
	Описание.Вставить("synonym", ОбъектМетаданные.Синоним);
	Описание.Вставить("attributes", ИменаКоллекции(ОбъектМетаданные.Реквизиты));
	Описание.Вставить("tabular_sections", ИменаКоллекции(ОбъектМетаданные.ТабличныеЧасти));
	Описание.Вставить("dimensions", ИменаКоллекции(ОбъектМетаданные.Измерения));
	Описание.Вставить("resources", ИменаКоллекции(ОбъектМетаданные.Ресурсы));
	Возврат Описание;
КонецФункции

Функция ИменаКоллекции(Коллекция)
	Результат = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Результат.Добавить(Элемент.Имя);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СписокСправочника(ИмяСправочника)
	Результат = Новый Массив;
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Ссылка КАК ref,
		|	Код КАК code,
		|	Наименование КАК name
		|ИЗ
		|	Справочник." + ИмяСправочника + "
		|ГДЕ
		|	НЕ ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("ref", Строка(Выборка.ref));
		Строка.Вставить("code", Выборка.code);
		Строка.Вставить("name", Выборка.name);
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СписокРолей()
	Результат = Новый Массив;
	Для Каждого Роль Из Метаданные.Роли Цикл
		Результат.Добавить(Роль.Имя);
	КонецЦикла;
	Возврат Результат;
КонецФункции
