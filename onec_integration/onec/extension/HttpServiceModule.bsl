// Шаблон модуля HTTP-сервиса расширения 1С.
// Методы записи должны оставаться заблокированными, пока явно не включены флаги безопасности.

Функция Health(Запрос) Экспорт
	Возврат JsonОтвет(Новый Структура("success,database,generated_at", Истина, Метаданные.Имя, ТекущаяДата()));
КонецФункции

Функция Metadata(Запрос) Экспорт
	Возврат JsonОтвет(СформироватьДиагностическийОтчет());
КонецФункции

Функция Stocks(Запрос) Экспорт
	// Реальные имена регистра и полей заполняются только после обследования метаданных.
	Возврат ОшибкаJson("VALIDATION_ERROR", "Метод Stocks требует настройки реального регистра остатков по отчету Metadata.");
КонецФункции

Функция Assembly(Запрос) Экспорт
	Параметры = ПрочитатьJsonТело(Запрос);
	Если Не ЗначениеЗаполнено(Параметры.external_id) Тогда
		Возврат ОшибкаJson("VALIDATION_ERROR", "Не задан external_id.");
	КонецЕсли;
	Если Не РазрешенаЗаписьДокументов() Тогда
		Возврат JsonОтвет(Новый Структура("success,dry_run,external_id,document_ref", Истина, Истина, Параметры.external_id, Неопределено));
	КонецЕсли;
	Возврат ОшибкаJson("DOCUMENT_WRITE_ERROR", "Запись документов не реализована до завершения dry-run проверок.");
КонецФункции

Функция Transfer(Запрос) Экспорт
	Параметры = ПрочитатьJsonТело(Запрос);
	Если Не ЗначениеЗаполнено(Параметры.external_id) Тогда
		Возврат ОшибкаJson("VALIDATION_ERROR", "Не задан external_id.");
	КонецЕсли;
	Если Параметры.source_warehouse_id = Параметры.target_warehouse_id Тогда
		Возврат ОшибкаJson("VALIDATION_ERROR", "Склад-отправитель и склад-получатель должны различаться.");
	КонецЕсли;
	Если Не РазрешенаЗаписьДокументов() Тогда
		Возврат JsonОтвет(Новый Структура("success,dry_run,external_id,document_ref", Истина, Истина, Параметры.external_id, Неопределено));
	КонецЕсли;
	Возврат ОшибкаJson("DOCUMENT_WRITE_ERROR", "Запись документов не реализована до завершения dry-run проверок.");
КонецФункции

Функция РазрешенаЗаписьДокументов()
	Возврат Ложь; // Включается только отдельным изменением после приемки обследования и dry-run.
КонецФункции

Функция JsonОтвет(Данные)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ЗаписатьJsonВСтроку(Данные), КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ОшибкаJson(Код, Сообщение)
	Ошибка = Новый Структура;
	Ошибка.Вставить("success", Ложь);
	Ошибка.Вставить("error", Новый Структура("code,message", Код, Сообщение));
	Возврат JsonОтвет(Ошибка);
КонецФункции

Функция ПрочитатьJsonТело(Запрос)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

Функция ЗаписатьJsonВСтроку(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции
