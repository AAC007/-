# Copy this file outside the repository to:
# %LOCALAPPDATA%\BlankDemandPlanner\PzmcProduction\.env
# Keep the real password and tokens only in that external file.

PZMC_PRODUCTION_API_URL=http://192.168.88.179:82/
PZMC_PRODUCTION_LOGIN=
PZMC_PRODUCTION_SECRET_FILE=%LOCALAPPDATA%\BlankDemandPlanner\PzmcProduction\secrets.dat
PZMC_PRODUCTION_TIMEOUT_SECONDS=30
PZMC_PRODUCTION_CMO_GROUPS=
PZMC_PRODUCTION_MECHANICAL_ENTITY_ID=
PZMC_PRODUCTION_PERSONNEL_REFRESH_MINUTES=10

# For an administered service, the values below may be supplied as process
# environment variables instead of the DPAPI file. Do not commit real values.
# PZMC_PRODUCTION_API_TOKEN=
# PZMC_PRODUCTION_TOKEN=
# PZMC_PRODUCTION_PASSWORD=
