                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Размер" Margin="0,0,10,6" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SelectedFontSize}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Верхние кнопки" Margin="0,0,10,6" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ToolbarPlacements}" SelectedItem="{Binding SelectedToolbarPlacement}" DisplayMemberPath="DisplayName" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Вкладки" Margin="0,0,10,6" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding NavigationPlacements}" SelectedItem="{Binding SelectedNavigationPlacement}" DisplayMemberPath="DisplayName" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Иконка" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="5" Grid.Column="1">
                                <Button DockPanel.Dock="Right" Content="Выбрать" Command="{Binding ChooseIconCommand}" />
                                <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Учетная запись" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SignedInUserText}" Margin="0,4,0,8" Foreground="#57606A" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Текущий пароль" Margin="0,0,10,6" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Новый пароль" Margin="0,0,10,6" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Повтор пароля" Margin="0,0,10,0" />
                            <DockPanel Grid.Row="4" Grid.Column="1">
                                <Button DockPanel.Dock="Right" Content="Сменить" Command="{Binding ChangeOwnPasswordCommand}" />
                                <TextBox Text="{Binding RepeatPassword, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Пользователи и права доступа" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Content="Новый" Command="{Binding NewUserCommand}" />
                            <Button Content="Сгенерировать пароль" Command="{Binding GeneratePasswordCommand}" />
                            <Button Content="Сохранить пользователя" Command="{Binding SaveUserCommand}" />
                            <Button Content="Сбросить пароль" Command="{Binding ResetUserPasswordCommand}" />
                            <Button Content="Удалить пользователя" Command="{Binding DeleteUserCommand}" />
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListBox Grid.Column="0" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="UserName" />
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин" Margin="0,0,8,6" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя" Margin="0,0,8,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UserDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль" Margin="0,0,8,6" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GeneratedPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Администратор" IsChecked="{Binding UserIsAdmin}" Margin="0,0,0,6" />
                                <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Активен" IsChecked="{Binding UserIsActive}" />
                            </Grid>
                            <DockPanel Grid.Column="4">
                                <TextBlock DockPanel.Dock="Top" Text="Права по вкладкам" Margin="0,0,0,6" />
                                <DataGrid ItemsSource="{Binding PermissionRows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="False"
                                          SelectionUnit="Cell"
                                          ClipboardCopyMode="ExcludeHeader">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Вкладка" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="Чтение" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding CanRead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Редактирование" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding CanEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DeveloperModeViewModel}">
            <DockPanel Margin="16">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Режим разработчика" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusText}" Margin="16,7,0,0" Foreground="#57606A" TextWrapping="Wrap" />
                </DockPanel>

                <Border Style="{StaticResource CardStyle}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Редактирование справочников интерфейса"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TabControl>
                            <TabItem Header="Ед. измерения">
                                <DockPanel Margin="0,10,0,0">
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <Button Content="Добавить" Command="{Binding AddUnitCommand}" IsEnabled="{Binding IsAdmin}" />
                                        <Button Content="Удалить" Command="{Binding RemoveUnitCommand}" CommandParameter="{Binding SelectedItem, ElementName=DeveloperUnitRowsGrid}" IsEnabled="{Binding IsAdmin}" />
                                        <Button Content="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding IsAdmin}" />
                                    </WrapPanel>
                                    <DataGrid x:Name="DeveloperUnitRowsGrid" ItemsSource="{Binding UnitRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" IsReadOnly="False" SelectionUnit="FullRow" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                            <DataGridTextColumn Header="Наименование" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridCheckBoxColumn Header="Активно" Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Виды услуг">
                                <DockPanel Margin="0,10,0,0">
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <Button Content="Добавить" Command="{Binding AddServiceCommand}" IsEnabled="{Binding IsAdmin}" />
                                        <Button Content="Удалить" Command="{Binding RemoveServiceCommand}" CommandParameter="{Binding SelectedItem, ElementName=DeveloperServiceRowsGrid}" IsEnabled="{Binding IsAdmin}" />
                                        <Button Content="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding IsAdmin}" />
                                    </WrapPanel>
                                    <DataGrid x:Name="DeveloperServiceRowsGrid" ItemsSource="{Binding ServiceRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" IsReadOnly="False" SelectionUnit="FullRow" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                            <DataGridTextColumn Header="Наименование" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridCheckBoxColumn Header="Активно" Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Условия поставки">
                                <DockPanel Margin="0,10,0,0">
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <Button Content="Добавить" Command="{Binding AddSupplyCommand}" IsEnabled="{Binding IsAdmin}" />
                                        <Button Content="Удалить" Command="{Binding RemoveSupplyCommand}" CommandParameter="{Binding SelectedItem, ElementName=DeveloperSupplyRowsGrid}" IsEnabled="{Binding IsAdmin}" />
                                        <Button Content="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding IsAdmin}" />
                                    </WrapPanel>
                                    <DataGrid x:Name="DeveloperSupplyRowsGrid" ItemsSource="{Binding SupplyRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" IsReadOnly="False" SelectionUnit="FullRow" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                            <DataGridTextColumn Header="Наименование" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridCheckBoxColumn Header="Активно" Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Виды заготовок">
                                <DockPanel Margin="0,10,0,0">
                                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <Button Content="Добавить" Command="{Binding AddBlankTypeCommand}" IsEnabled="{Binding IsAdmin}" />
                                        <Button Content="Удалить" Command="{Binding RemoveBlankTypeCommand}" CommandParameter="{Binding SelectedItem, ElementName=DeveloperBlankTypeRowsGrid}" IsEnabled="{Binding IsAdmin}" />
                                        <Button Content="Сохранить" Command="{Binding SaveCommand}" IsEnabled="{Binding IsAdmin}" />
                                    </WrapPanel>
                                    <DataGrid x:Name="DeveloperBlankTypeRowsGrid" ItemsSource="{Binding BlankTypeRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" IsReadOnly="False" SelectionUnit="FullRow" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                                            <DataGridTextColumn Header="Наименование" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridCheckBoxColumn Header="Активно" Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SimplePageViewModel}">
            <StackPanel Margin="22">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="22,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,6">
                    <Image Source="/Assets/PZMC_1.png" Height="44" Width="84" Stretch="Uniform" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="{Binding Settings.ToolbarHorizontalAlignment}" VerticalAlignment="Center">
                    <WrapPanel Margin="0,0,10,6">
                        <Button Content="Загрузить потребность из ПП" Command="{Binding ImportDemandCommand}" />
                        <Button Content="Обновить данные 1С" Command="{Binding SyncStockFromOneCCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StockSyncStatusText}" Margin="0,7,18,6" TextWrapping="Wrap" MaxWidth="520" />
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Глобальный поиск" />
                        <TextBox Width="320" Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Глобальный поиск" />
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="{Binding UndoStatusText}" Command="{Binding UndoCommand}" ToolTip="Отменить последнее действие, до 10 шагов назад" />
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding CurrentUserText}" Margin="14,7,0,6" Foreground="#57606A" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <DockPanel LastChildFill="True">
            <Border Background="#24292F"
                    DockPanel.Dock="{Binding Settings.NavigationDock}"
                    Width="{Binding Settings.NavigationPanelWidth}"
                    Height="{Binding Settings.NavigationPanelHeight}">
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         Margin="{Binding Settings.NavigationListMargin}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding DataContext.Settings.NavigationOrientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="NavigationItem_PreviewMouseRightButtonDown" />
                            <EventSetter Event="MouseRightButtonUp" Handler="NavigationItem_MouseRightButtonUp" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Padding="8,10" FontSize="13" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" />
        </DockPanel>
    </DockPanel>
</Window>

