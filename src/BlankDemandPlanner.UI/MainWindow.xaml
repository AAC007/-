<Window x:Class="BlankDemandPlanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BlankDemandPlanner.UI.ViewModels"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="{Binding WindowTitle}"
        Height="820"
        Width="1320"
        MinHeight="720"
        MinWidth="900"
        Icon="/Assets/PZMC_1.ico"
        Language="ru-RU"
        Background="{StaticResource SurfaceBrush}">
    <Window.CommandBindings>
        <CommandBinding Command="Copy" CanExecute="CopySelectedCells_CanExecute" Executed="CopySelectedCells_Executed" />
    </Window.CommandBindings>
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="DashboardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="104" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF6FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#54AEFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DDF4FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#0969DA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditCurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F6F8FA" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8C959F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EAECEF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <TextBlock Text="Главная" FontSize="26" FontWeight="SemiBold" />
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,6">
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.Library, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}" Margin="0"><StackPanel><TextBlock Text="Деталей" /><TextBlock Text="{Binding Parts}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.Normalization, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}" Margin="0"><StackPanel><TextBlock Text="Заготовок" /><TextBlock Text="{Binding CanonicalBlanks}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.Library, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}" Margin="0"><StackPanel><TextBlock Text="Без заготовки" /><TextBlock Text="{Binding PartsWithoutBlank}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.Msk, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}" Margin="0"><StackPanel><TextBlock Text="Без МСК" /><TextBlock Text="{Binding PartsWithoutMsk}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToNsiDuplicatesCommand, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}" Margin="0"><StackPanel><TextBlock Text="Дубли НСИ" /><TextBlock Text="{Binding DuplicateCandidates}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                    </UniformGrid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding LastDemandImport, StringFormat=Последний импорт потребности: {0}}" Margin="0,8" />
                        <TextBlock Text="{Binding LastStockImport, StringFormat=Последний импорт остатков: {0}}" Margin="0,8" />
                        <TextBlock Text="{Binding LastCalculation, StringFormat=Последний расчет: {0}}" Margin="0,8" />
                    </StackPanel>
                    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,18,0,0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="540" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/PZMC_.png" Width="520" Height="104" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="42,0,0,0">
                                <TextBlock Text="Создаём, развиваем, гордимся" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastSoftwareUpdate}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding DeveloperInfo}" />
                            </StackPanel>
                        </Grid>
                    </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DemandViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Потребность" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BatchText}" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Поиск по потребности" />
                            <TextBox Width="360" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по проекту, номеру станка, IPS или наименованию" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ограничить, дней" />
                            <TextBox Width="90" Text="{Binding DaysLimit, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 - без ограничения по дате потребности" />
                        </StackPanel>
                        <Button Content="+" Command="{Binding AddManualRowCommand}" ToolTip="Добавить строку ручной потребности" />
                        <Button Content="Удалить выделенные" Command="{Binding DeleteDemandRowsCommand}" CommandParameter="{Binding SelectedCells, ElementName=DemandRowsGrid}" />
                        <Button Content="Сохранить строки" Command="{Binding SaveManualRowsCommand}" />
                        <Button Content="Обновить" Command="{Binding LoadCommand}" />
                        <Button Content="{Binding DetailPanelButtonText}" Command="{Binding ToggleDetailPanelCommand}" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,7,0,0" />
                    </WrapPanel>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="620" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="DemandRowsGrid" Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectedCellsChanged="DemandRowsGrid_SelectedCellsChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="CellOrRowHeader" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader" IsReadOnly="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="DemandRow_PreviewMouseRightButtonDown" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Открыть чертеж (PDF)"
                                                      Command="{Binding PlacementTarget.Tag.OpenDrawingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Проект" Binding="{Binding Project}" Width="240" />
                            <DataGridTextColumn Header="№ станка" Binding="{Binding MachineNumber}" Width="120" />
                            <DataGridTextColumn Header="IPS детали" Binding="{Binding Ips}" Width="130" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Ед. изм." Binding="{Binding UnitName}" Width="90" />
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100" />
                            <DataGridTextColumn Header="В производстве" Binding="{Binding InProductionQuantity}" Width="115" IsReadOnly="True" />
                            <DataGridTextColumn Header="Дата потребн." Binding="{Binding DemandDate}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Детализация" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Margin="0,4,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding DetailRows}" EnableRowVirtualization="True" HeadersVisibility="Column" IsReadOnly="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DemandDate}" Width="82" />
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="65" />
                                    <DataGridTextColumn Header="В пр-ве" Binding="{Binding InProductionQuantity}" Width="65" />
                                    <DataGridTextColumn Header="Ост. после" Binding="{Binding WorkInProgressAfter}" Width="75" />
                                    <DataGridTextColumn Header="Проект" Binding="{Binding Project}" Width="230" />
                                    <DataGridTextColumn Header="№ станка" Binding="{Binding MachineNumber}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Справочник Деталей и Норм расходов материалов и заготовок" FontSize="20" FontWeight="SemiBold" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="IPS" /><TextBox Text="{Binding EditIps, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Width="150" Margin="0,0,10,8"><TextBlock Text="Обозначение" /><TextBox Text="{Binding EditDesignation, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,8"><TextBlock Text="Наименование" /><TextBox Text="{Binding EditPartName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Width="170" Margin="0,0,10,8"><TextBlock Text="Вид заготовки" /><ComboBox ItemsSource="{Binding BlankTypes}" SelectedItem="{Binding SelectedBlankType}" DisplayMemberPath="DisplayName" /></StackPanel>
                                <StackPanel MinWidth="260" Width="360" Margin="0,0,10,8"><TextBlock Text="Заготовка" /><ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectionChanged="EditableComboBox_SelectionChanged" Text="{Binding BlankSearch, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding BlankSuggestions}" SelectedItem="{Binding SelectedBlank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName" /></StackPanel>
                                <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Text="Код УТ" /><TextBox Text="{Binding SelectedOneCCode}" IsReadOnly="True" /></StackPanel>
                                <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Text="Количество" /><TextBox Text="{Binding ConsumptionQuantityText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Width="130" Margin="0,0,10,8"><TextBlock Text="Ед. измерения" /><ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="DisplayName" /></StackPanel>
                                <StackPanel Width="105" Margin="0,0,10,8"><TextBlock Text="Срок, дней" /><TextBox Text="{Binding BlankLeadTimeDaysText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <WrapPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Button Content="+" Command="{Binding NewLibraryEntryCommand}" ToolTip="Очистить форму для ручного добавления строки библиотеки" />
                                    <Button Content="Очистить" Command="{Binding NewLibraryEntryCommand}" />
                                    <Button Content="Сохранить" Command="{Binding SaveLibraryEntryCommand}" />
                                </WrapPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,2,0,0">
                                <TextBlock Text="Услуги:" VerticalAlignment="Center" Margin="0,0,10,8" />
                                <CheckBox Content="{Binding NitridingServiceLabel}" IsChecked="{Binding EditRequiresNitriding}" Visibility="{Binding IsNitridingServiceVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,14,8" />
                                <CheckBox Content="{Binding HeatTreatmentServiceLabel}" IsChecked="{Binding EditRequiresHeatTreatment}" Visibility="{Binding IsHeatTreatmentServiceVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,14,8" />
                                <CheckBox Content="{Binding ChemicalOxidationServiceLabel}" IsChecked="{Binding EditRequiresChemicalOxidation}" Visibility="{Binding IsChemicalOxidationServiceVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,14,8" />
                                <CheckBox Content="{Binding KeywayServiceLabel}" IsChecked="{Binding EditRequiresKeyway}" Visibility="{Binding IsKeywayServiceVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,14,8" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,0">
                                <TextBlock Text="Условие поставки заготовки:" VerticalAlignment="Center" Margin="0,0,10,8" />
                                <CheckBox Content="{Binding BlankSupplyHeatTreatmentLabel}" IsChecked="{Binding EditBlankSupplyRequiresHeatTreatment}" Visibility="{Binding IsBlankSupplyHeatTreatmentVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,14,8" />
                                <CheckBox Content="{Binding BlankSupplyLaserCuttingLabel}" IsChecked="{Binding EditBlankSupplyRequiresLaserCutting}" Visibility="{Binding IsBlankSupplyLaserCuttingVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,14,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,8,0,0">
                        <StackPanel><TextBlock Text="Поиск" /><TextBox Width="340" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Вид заготовки" /><ComboBox Width="160" ItemsSource="{Binding BlankTypeFilters}" SelectedItem="{Binding SelectedBlankTypeFilter}" DisplayMemberPath="DisplayName" /></StackPanel>
                        <StackPanel><TextBlock Text="Ед. изм." /><ComboBox Width="110" ItemsSource="{Binding UnitFilters}" SelectedItem="{Binding SelectedUnitFilter}" DisplayMemberPath="DisplayName" /></StackPanel>
                        <StackPanel>
                            <TextBlock Text="Связь" />
                            <ComboBox Width="130" ItemsSource="{Binding BlankStatusFilters}" SelectedItem="{Binding SelectedBlankStatusFilter}" DisplayMemberPath="DisplayName" />
                            <CheckBox Content="В потребности" IsChecked="{Binding DemandOnly}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="Импорт библиотеки" Command="{Binding ImportLibraryCommand}" />
                        <Button Content="Выгрузить в Excel" Command="{Binding ExportLibraryCommand}" />
                        <Button Content="Удалить выделенные" Command="{Binding DeleteLibraryRowsCommand}" CommandParameter="{Binding SelectedCells, ElementName=LibraryRowsGrid}" />
                        <Button Content="Обновить" Command="{Binding LoadCommand}" />
                        <TextBlock Text="{Binding EditorStatus}" Margin="12,7,0,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SummaryText}" Margin="0,6,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <DataGrid x:Name="LibraryRowsGrid" ItemsSource="{Binding Rows}" SelectedCellsChanged="LibraryRowsGrid_SelectedCellsChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="LibraryRow_PreviewMouseRightButtonDown" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Карточка объекта"
                                                  Command="{Binding PlacementTarget.Tag.OpenObjectCardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Открыть чертеж (PDF)"
                                                  Command="{Binding PlacementTarget.Tag.OpenDrawingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Редактировать"
                                                  Command="{Binding PlacementTarget.Tag.EditLibraryRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Удалить"
                                                  Command="{Binding PlacementTarget.Tag.DeleteLibraryRowsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                    <Setter Property="Background" Value="#FFCC00" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IPS" Binding="{Binding Ips}" Width="110" />
                        <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="130" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding PartName}" Width="220" />
                        <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="160" />
                        <DataGridTextColumn Header="Вид заготовки" Binding="{Binding BlankType}" Width="125" />
                        <DataGridTextColumn Header="Заготовка" Binding="{Binding BlankName}" Width="260" />
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="120" />
                        <DataGridTextColumn Header="Условие поставки заготовки" Binding="{Binding BlankSupplyRequirement}" Width="180" />
                        <DataGridTextColumn Header="Код УТ" Binding="{Binding OneCCode}" Width="120" />
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="90" />
                        <DataGridTextColumn Header="Ед. измерения" Binding="{Binding UnitName}" Width="95" />
                        <DataGridTextColumn Header="Срок заготовки, дней" Binding="{Binding BlankLeadTimeDaysText}" Width="130" />
                        <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="150" />
                        <DataGridTextColumn Header="Обновлено" Binding="{Binding UpdatedAt}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NormalizationViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Нормативно-справочная информация" FontSize="24" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Добавить из 1С" Command="{Binding AddFromOneCCommand}" />
                        <StackPanel><TextBlock Text="Поиск по НСИ" /><TextBox Width="300" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Вид заготовки" /><ComboBox Width="160" ItemsSource="{Binding BlankTypeFilters}" SelectedItem="{Binding SelectedBlankTypeFilter}" DisplayMemberPath="DisplayName" /></StackPanel>
                        <StackPanel><TextBlock Text="Размер" /><TextBox Width="150" Text="{Binding SizeFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Марка" /><TextBox Width="170" Text="{Binding MaterialFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <CheckBox Content="Только дубли" IsChecked="{Binding DuplicatesOnly}" VerticalAlignment="Bottom" Margin="8,0,0,5" />
                        <Button Content="Обновить" Command="{Binding LoadCommand}" />
                        <Button Content="{Binding UsagePanelButtonText}" Command="{Binding ToggleUsagePanelCommand}" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,7,0,0" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SummaryText}" Margin="0,6,0,0" FontWeight="SemiBold" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <WrapPanel>
                            <StackPanel Width="130" Margin="0,0,10,8"><TextBlock Text="Код УТ / IPS" /><TextBox Text="{Binding EditOneCCode, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="240" Margin="0,0,10,8"><TextBlock Text="Наименование по 1С УТ" /><TextBox Text="{Binding EditSourceName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="170" Margin="0,0,10,8"><TextBlock Text="Вид заготовки" /><ComboBox ItemsSource="{Binding BlankTypes}" SelectedItem="{Binding EditBlankType}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="Ед. изм." /><ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding EditUnit}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Width="170" Margin="0,0,10,8"><TextBlock Text="Марка материала" /><ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectionChanged="EditableComboBox_SelectionChanged" Text="{Binding EditMaterial, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding MaterialSuggestions}" /></StackPanel>
                            <StackPanel Width="150" Margin="0,0,10,8"><TextBlock Text="Размер" /><TextBox Text="{Binding EditSize, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Width="170" Margin="0,0,10,8"><TextBlock Text="ГОСТ материала" /><ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" SelectionChanged="EditableComboBox_SelectionChanged" Text="{Binding EditMaterialGost, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding MaterialGostSuggestions}" /></StackPanel>
