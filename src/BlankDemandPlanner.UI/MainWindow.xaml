<Window x:Class="BlankDemandPlanner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BlankDemandPlanner.UI.ViewModels"
        Title="Заказ заготовок ЦМО v2026.07.27.3"
        Height="820"
        Width="1320"
        MinHeight="720"
        MinWidth="900"
        Icon="/Assets/pzmc-symbol.png"
        Language="ru-RU"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="DashboardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="104" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <ScrollViewer>
                <StackPanel Margin="22">
                    <TextBlock Text="Главная" FontSize="26" FontWeight="SemiBold" />
                    <UniformGrid Columns="3" Margin="0,18,0,6">
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.Library, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Деталей" /><TextBlock Text="{Binding Parts}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.Normalization, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Заготовок" /><TextBlock Text="{Binding CanonicalBlanks}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.Library, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Без заготовки" /><TextBlock Text="{Binding PartsWithoutBlank}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding DataContext.Msk, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Без МСК" /><TextBlock Text="{Binding PartsWithoutMsk}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                        <Button Style="{StaticResource DashboardButtonStyle}" Command="{Binding DataContext.NavigateToNsiDuplicatesCommand, RelativeSource={RelativeSource AncestorType=Window}}"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Дубли НСИ" /><TextBlock Text="{Binding DuplicateCandidates}" FontSize="28" FontWeight="SemiBold" /></StackPanel></Border></Button>
                    </UniformGrid>
                    <TextBlock Text="{Binding LastDemandImport, StringFormat=Последний импорт потребности: {0}}" Margin="0,8" />
                    <TextBlock Text="{Binding LastStockImport, StringFormat=Последний импорт остатков: {0}}" Margin="0,8" />
                    <TextBlock Text="{Binding LastCalculation, StringFormat=Последний расчет: {0}}" Margin="0,8" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/pzmc-logo-black-transparent.png" Height="110" Stretch="Uniform" HorizontalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Создаём, развиваем, гордимся" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastSoftwareUpdate}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding DeveloperInfo}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DemandViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Потребность" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BatchText}" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Поиск по потребности" />
                            <TextBox Width="360" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по проекту, номеру станка, IPS или наименованию" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ограничить, дней" />
                            <TextBox Width="90" Text="{Binding DaysLimit, UpdateSourceTrigger=PropertyChanged}" ToolTip="0 - без ограничения по дате потребности" />
                        </StackPanel>
                        <Button Content="+" Command="{Binding AddManualRowCommand}" ToolTip="Добавить строку ручной потребности" />
                        <Button Content="Удалить выделенные" Command="{Binding DeleteDemandRowsCommand}" CommandParameter="{Binding SelectedCells, ElementName=DemandRowsGrid}" />
                        <Button Content="Сохранить строки" Command="{Binding SaveManualRowsCommand}" />
                        <Button Content="Обновить" Command="{Binding LoadCommand}" />
                        <Button Content="{Binding DetailPanelButtonText}" Command="{Binding ToggleDetailPanelCommand}" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,7,0,0" />
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="620" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="DemandRowsGrid" Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectedCellsChanged="DemandRowsGrid_SelectedCellsChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="CellOrRowHeader" SelectionMode="Single" ClipboardCopyMode="ExcludeHeader" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Проект" Binding="{Binding Project}" Width="240" />
                            <DataGridTextColumn Header="№ станка" Binding="{Binding MachineNumber}" Width="120" />
                            <DataGridTextColumn Header="IPS детали" Binding="{Binding Ips}" Width="130" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Ед. изм." Binding="{Binding UnitName}" Width="90" />
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100" />
                            <DataGridTextColumn Header="В производстве" Binding="{Binding InProductionQuantity}" Width="115" IsReadOnly="True" />
                            <DataGridTextColumn Header="Дата потребн." Binding="{Binding DemandDate}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Visibility="{Binding IsDetailPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Детализация" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Margin="0,4,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding DetailRows}" EnableRowVirtualization="True" HeadersVisibility="Column" IsReadOnly="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DemandDate}" Width="82" />
                                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="65" />
                                    <DataGridTextColumn Header="В пр-ве" Binding="{Binding InProductionQuantity}" Width="65" />
                                    <DataGridTextColumn Header="Ост. после" Binding="{Binding WorkInProgressAfter}" Width="75" />
                                    <DataGridTextColumn Header="Проект" Binding="{Binding Project}" Width="230" />
                                    <DataGridTextColumn Header="№ станка" Binding="{Binding MachineNumber}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Справочник Деталей и Норм расходов материалов и заготовок" FontSize="20" FontWeight="SemiBold" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="IPS" /><TextBox Text="{Binding EditIps, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Обозначение" /><TextBox Text="{Binding EditDesignation, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Наименование" /><TextBox Text="{Binding EditPartName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Вид заготовки" /><ComboBox ItemsSource="{Binding BlankTypes}" SelectedItem="{Binding SelectedBlankType}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,10,0"><TextBlock Text="Заготовка" /><ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" Text="{Binding BlankSearch, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding BlankSuggestions}" SelectedItem="{Binding SelectedBlank, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Grid.Column="5" Margin="0,0,10,0"><TextBlock Text="Код УТ" /><TextBox Text="{Binding SelectedOneCCode}" IsReadOnly="True" /></StackPanel>
                            <StackPanel Grid.Column="6" Margin="0,0,10,0"><TextBlock Text="Количество" /><TextBox Text="{Binding ConsumptionQuantityText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="7" Margin="0,0,10,0"><TextBlock Text="Ед. измерения" /><ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Grid.Column="8" Margin="0,0,10,0"><TextBlock Text="Срок, дней" /><TextBox Text="{Binding BlankLeadTimeDaysText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="+" Command="{Binding NewLibraryEntryCommand}" ToolTip="Очистить форму для ручного добавления строки библиотеки" />
                                <Button Content="Очистить" Command="{Binding NewLibraryEntryCommand}" />
                                <Button Content="Сохранить" Command="{Binding SaveLibraryEntryCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel><TextBlock Text="Поиск" /><TextBox Width="340" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Вид заготовки" /><ComboBox Width="160" ItemsSource="{Binding BlankTypeFilters}" SelectedItem="{Binding SelectedBlankTypeFilter}" DisplayMemberPath="DisplayName" /></StackPanel>
                        <StackPanel><TextBlock Text="Ед. изм." /><ComboBox Width="110" ItemsSource="{Binding UnitFilters}" SelectedItem="{Binding SelectedUnitFilter}" DisplayMemberPath="DisplayName" /></StackPanel>
                        <StackPanel><TextBlock Text="Связь" /><ComboBox Width="130" ItemsSource="{Binding BlankStatusFilters}" SelectedItem="{Binding SelectedBlankStatusFilter}" DisplayMemberPath="DisplayName" /></StackPanel>
                        <Button Content="Импорт библиотеки" Command="{Binding ImportLibraryCommand}" />
                        <Button Content="Выгрузить в Excel" Command="{Binding ExportLibraryCommand}" />
                        <Button Content="Удалить выделенные" Command="{Binding DeleteLibraryRowsCommand}" CommandParameter="{Binding SelectedCells, ElementName=LibraryRowsGrid}" />
                        <Button Content="Обновить" Command="{Binding LoadCommand}" />
                        <TextBlock Text="{Binding EditorStatus}" Margin="12,7,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}" Margin="0,6,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <DataGrid x:Name="LibraryRowsGrid" ItemsSource="{Binding Rows}" SelectedCellsChanged="LibraryRowsGrid_SelectedCellsChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="Cell" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="LibraryRow_PreviewMouseRightButtonDown" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Редактировать"
                                                  Command="{Binding PlacementTarget.Tag.EditLibraryRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Удалить"
                                                  Command="{Binding PlacementTarget.Tag.DeleteLibraryRowsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IPS" Binding="{Binding Ips}" Width="110" />
                        <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="130" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding PartName}" Width="220" />
                        <DataGridTextColumn Header="Вид заготовки" Binding="{Binding BlankType}" Width="125" />
                        <DataGridTextColumn Header="Заготовка" Binding="{Binding BlankName}" Width="260" />
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="120" />
                        <DataGridTextColumn Header="Код УТ" Binding="{Binding OneCCode}" Width="120" />
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="90" />
                        <DataGridTextColumn Header="Ед. измерения" Binding="{Binding UnitName}" Width="95" />
                        <DataGridTextColumn Header="Срок заготовки, дней" Binding="{Binding BlankLeadTimeDaysText}" Width="130" />
                        <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="150" />
                        <DataGridTextColumn Header="Обновлено" Binding="{Binding UpdatedAt}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NormalizationViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="НСИ" FontSize="24" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Импортировать" Command="{Binding ImportCommand}" />
                        <Button Content="В архив" Command="{Binding ArchiveSelectedRowsCommand}" CommandParameter="{Binding SelectedItems, ElementName=NsiRowsGrid}" />
                        <Button Content="Удалить" Command="{Binding DeleteSelectedRowsCommand}" CommandParameter="{Binding SelectedItems, ElementName=NsiRowsGrid}" />
                        <StackPanel><TextBlock Text="Поиск по НСИ" /><TextBox Width="300" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Вид заготовки" /><ComboBox Width="160" ItemsSource="{Binding BlankTypeFilters}" SelectedItem="{Binding SelectedBlankTypeFilter}" DisplayMemberPath="DisplayName" /></StackPanel>
                        <StackPanel><TextBlock Text="Размер" /><TextBox Width="150" Text="{Binding SizeFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <StackPanel><TextBlock Text="Марка" /><TextBox Width="170" Text="{Binding MaterialFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        <CheckBox Content="Только дубли" IsChecked="{Binding DuplicatesOnly}" VerticalAlignment="Bottom" Margin="8,0,0,5" />
                        <Button Content="Обновить" Command="{Binding LoadCommand}" />
                        <Button Content="{Binding UsagePanelButtonText}" Command="{Binding ToggleUsagePanelCommand}" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,7,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding SummaryText}" Margin="0,6,0,0" FontWeight="SemiBold" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Код УТ / IPS" /><TextBox Text="{Binding EditOneCCode, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Наименование по 1С УТ" /><TextBox Text="{Binding EditSourceName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Вид заготовки" /><ComboBox ItemsSource="{Binding BlankTypes}" SelectedItem="{Binding EditBlankType}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Ед. изм." /><ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding EditUnit}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,10,0"><TextBlock Text="Марка материала" /><ComboBox IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" Text="{Binding EditMaterial, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding MaterialSuggestions}" /></StackPanel>
                            <StackPanel Grid.Column="5" Margin="0,0,10,0"><TextBlock Text="Размер" /><TextBox Text="{Binding EditSize, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="6" Margin="0,0,10,0"><TextBlock Text="ГОСТ материала" /><TextBox Text="{Binding EditMaterialGost, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="7" Margin="0,0,10,0"><TextBlock Text="ГОСТ сортамента" /><TextBox Text="{Binding EditProfileGost, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="+" Command="{Binding NewNsiBlankCommand}" ToolTip="Очистить форму для ручного добавления заготовки в НСИ" />
                                <Button Content="Очистить" Command="{Binding NewNsiBlankCommand}" />
                                <Button Content="Сохранить правку НСИ" Command="{Binding SaveSelectedEditCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="NsiRowsGrid" Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectedCellsChanged="NsiRowsGrid_SelectedCellsChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="CellOrRowHeader" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Редактировать"
                                                      Command="{Binding PlacementTarget.Tag.EditNsiRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Удалить"
                                                      Command="{Binding PlacementTarget.Tag.DeleteSelectedRowsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Вид" Binding="{Binding BlankType}" Width="160" />
                            <DataGridTextColumn Header="Марка" Binding="{Binding Material}" Width="120" />
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="150" />
                            <DataGridTextColumn Header="Код УТ / IPS" Binding="{Binding OneCCode}" Width="120" />
                            <DataGridTextColumn Header="Наименование по 1С УТ" Binding="{Binding SourceName}" Width="330" />
                            <DataGridTextColumn Header="Ед. изм." Binding="{Binding UnitName}" Width="90" />
                            <DataGridTextColumn Header="ГОСТ материала" Binding="{Binding MaterialGost}" Width="130" />
                            <DataGridTextColumn Header="ГОСТ сортамента" Binding="{Binding ProfileGost}" Width="130" />
                            <DataGridTextColumn Header="Остаток на ЦМО" Binding="{Binding CmoStockQuantity}" Width="120" />
                            <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseStockQuantity}" Width="130" />
                            <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="150" />
                            <DataGridTextColumn Header="Обновлено" Binding="{Binding UpdatedAt}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Visibility="{Binding IsUsagePanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Применяемость" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding UsageStatusText}" Margin="0,4,0,8" TextWrapping="Wrap" />
                            <DataGrid ItemsSource="{Binding UsageRows}" EnableRowVirtualization="True" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="IPS" Binding="{Binding Ips}" Width="90" />
                                    <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="110" />
                                    <DataGridTextColumn Header="Деталь" Binding="{Binding PartName}" Width="180" />
                                    <DataGridTextColumn Header="Кол." Binding="{Binding Quantity}" Width="60" />
                                    <DataGridTextColumn Header="Ед." Binding="{Binding UnitName}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BlankSelectionViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Подбор заготовок" FontSize="24" FontWeight="SemiBold" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Поиск детали без заготовки" />
                                <ComboBox IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          IsDropDownOpen="{Binding IsPartSuggestionsOpen, Mode=TwoWay}"
                                          Text="{Binding PartSearch, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding PartSuggestions}"
                                          SelectedItem="{Binding SelectedPart}"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Выбранная заготовка" />
                                <TextBox Text="{Binding SelectedBlankRow.SourceName}" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Норма расхода" />
                                <TextBox Text="{Binding ConsumptionQuantityText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Ед." />
                                <ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <Button Grid.Column="4" Content="Добавить в библиотеку" Command="{Binding AddToLibraryCommand}" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Вид заготовки" /><ComboBox ItemsSource="{Binding BlankTypeFilters}" SelectedItem="{Binding SelectedBlankType}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Материал" /><TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="D" /><TextBox Text="{Binding DiameterText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Ширина" /><TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,10,0"><TextBlock Text="Высота" /><TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="5" Margin="0,0,10,0"><TextBlock Text="Толщина" /><TextBox Text="{Binding ThicknessText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="6" Margin="0,0,10,0"><TextBlock Text="Стенка" /><TextBox Text="{Binding WallThicknessText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="7" Margin="0,0,10,0"><TextBlock Text="Длина" /><TextBox Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Подобрать" Command="{Binding FindCommand}" />
                                <Button Content="Очистить" Command="{Binding ClearCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedBlankRow}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Вид" Binding="{Binding BlankType}" Width="150" />
                        <DataGridTextColumn Header="Код УТ" Binding="{Binding OneCCode}" Width="120" />
                        <DataGridTextColumn Header="Заготовка" Binding="{Binding SourceName}" Width="330" />
                        <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="130" />
                        <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="170" />
                        <DataGridTextColumn Header="Ед." Binding="{Binding UnitName}" Width="70" />
                        <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="90" />
                        <DataGridTextColumn Header="Припуск" Binding="{Binding Allowance}" Width="90" />
                        <DataGridTextColumn Header="Расшифровка" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MskViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="МСК" FontSize="24" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="Поиск детали" />
                            <TextBox Width="360" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по IPS, обозначению, наименованию или имени файла МСК" />
                        </StackPanel>
                        <Button Content="Обновить данные МСК" Command="{Binding RefreshFromFolderCommand}" Margin="0,16,0,6" />
                        <Button Content="Открыть Excel МСК" Command="{Binding OpenSelectedMskCommand}" Margin="6,16,0,6" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,22,0,6" TextWrapping="Wrap" MaxWidth="620" />
                    </WrapPanel>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="MskRowsGrid"
                              Grid.Column="0"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow}"
                              SelectedCellsChanged="MskRowsGrid_SelectedCellsChanged"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionUnit="CellOrRowHeader"
                              ClipboardCopyMode="ExcludeHeader"
                              IsReadOnly="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="MouseEnter" Handler="MskRow_MouseEnter" />
                                <EventSetter Event="MouseLeftButtonUp" Handler="MskRow_MouseLeftButtonUp" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IPS" Binding="{Binding Ips}" Width="110" />
                            <DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="180" />
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Вид заготовки" Binding="{Binding BlankType}" Width="120" />
                            <DataGridTextColumn Header="Заготовка" Binding="{Binding BlankName}" Width="220" />
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="120" />
                            <DataGridTextColumn Header="Код УТ" Binding="{Binding OneCCode}" Width="115" />
                            <DataGridTextColumn Header="Норма" Binding="{Binding ConsumptionQuantity}" Width="80" />
                            <DataGridTextColumn Header="Ед." Binding="{Binding UnitName}" Width="70" />
                            <DataGridTextColumn Header="Срок" Binding="{Binding BlankLeadTimeDays}" Width="60" />
                            <DataGridTextColumn Header="МСК" Binding="{Binding HasMsk}" Width="70" />
                            <DataGridTextColumn Header="В библиотеке" Binding="{Binding HasLibraryPart}" Width="100" />
                            <DataGridTextColumn Header="Обновлено" Binding="{Binding ImportedAt}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Информация по детали" FontSize="18" FontWeight="SemiBold" />
                            <TextBox Text="{Binding DetailText}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     BorderThickness="0"
                                     Background="Transparent" />
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CalculationViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Расчет материалов" FontSize="24" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Произвести расчет" Command="{Binding CalculateCommand}" />
                        <Button Content="Сформировать заявку" Command="{Binding ExportCommand}" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,7,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Поиск заготовки в НСИ" /><TextBox Text="{Binding BlankSearch, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Заготовка" /><ComboBox ItemsSource="{Binding BlankSuggestions}" SelectedItem="{Binding SelectedBlank}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Кол-во на деталь" /><TextBox Text="{Binding ConsumptionQuantityText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Ед." /><ComboBox ItemsSource="{Binding UnitTypes}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="DisplayName" /></StackPanel>
                            <Button Grid.Column="4" Content="Добавить заготовку" Command="{Binding AssignBlankToSelectedCommand}" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding AssignmentStatus}" Margin="0,4,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Tag="{Binding}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="CellOrRowHeader" SelectionMode="Extended" ClipboardCopyMode="ExcludeHeader">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="CalculationRow_PreviewMouseRightButtonDown" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Добавить заготовку"
                                                  Command="{Binding PlacementTarget.Tag.AssignBlankToSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50" />
                        <DataGridTextColumn Header="ПС" Binding="{Binding ProductionSystem}" Width="180" />
                        <DataGridTextColumn Header="№ станка" Binding="{Binding MachineNumber}" Width="110" />
                        <DataGridTextColumn Header="IPS (изготавливаемой детали)" Binding="{Binding Ips}" Width="155" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="260" />
                        <DataGridTextColumn Header="Количество деталей" Binding="{Binding PartQuantity}" Width="120" />
                        <DataGridTextColumn Header="Код УТ (заготовки)" Binding="{Binding OneCCode}" Width="130" />
                        <DataGridTextColumn Header="Вид заготовки" Binding="{Binding BlankType}" Width="130" />
                        <DataGridTextColumn Header="Номенклатура" Binding="{Binding Nomenclature}" Width="300" />
                        <DataGridTextColumn Header="Ед. измерения" Binding="{Binding UnitName}" Width="95" />
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding MaterialQuantity}" Width="90" />
                        <DataGridTextColumn Header="Дата потребности заготовки" Binding="{Binding DemandDate}" Width="190" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="История обновлений" FontSize="24" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Обновить" Command="{Binding LoadCommand}" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,7,0,0" />
                    </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Rows}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="ExcludeHeader">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="240" />
                        <DataGridTextColumn Header="Дата обновления" Binding="{Binding UpdatedAt}" Width="140" />
                        <DataGridTextColumn Header="Что сделано" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <ScrollViewer>
                <StackPanel Margin="22" MaxWidth="780" HorizontalAlignment="Left">
                    <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" />
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Шрифт" Margin="0,0,12,10" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFontFamily}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Размер шрифта" Margin="0,0,12,10" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SelectedFontSize}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Положение кнопок" Margin="0,0,12,10" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ToolbarPlacements}" SelectedItem="{Binding SelectedToolbarPlacement}" DisplayMemberPath="DisplayName" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Иконка окна" Margin="0,0,12,10" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Выбрать" Command="{Binding ChooseIconCommand}" />
                                <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Фото/логотип" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <DockPanel Grid.Row="4" Grid.Column="1">
                                <Button DockPanel.Dock="Right" Content="Выбрать" Command="{Binding ChoosePhotoCommand}" />
                                <TextBox Text="{Binding PhotoPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Применить" Command="{Binding ApplyCommand}" />
                        <Button Content="Сбросить" Command="{Binding ResetCommand}" />
                        <TextBlock Text="{Binding StatusText}" Margin="12,7,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <Image Source="{Binding PhotoPath}" MaxHeight="220" Stretch="Uniform" HorizontalAlignment="Left" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SimplePageViewModel}">
            <StackPanel Margin="22">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="14,10">
            <WrapPanel HorizontalAlignment="{Binding Settings.ToolbarHorizontalAlignment}" VerticalAlignment="Center">
                <Image Source="/Assets/pzmc-logo-black-transparent.png" Height="44" Width="150" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,18,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                    <Button Content="Загрузить потребность из ПП" Command="{Binding ImportDemandCommand}" />
                    <Button Content="Обновить данные 1С" Command="{Binding SyncStockFromOneCCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StockSyncStatusText}" Margin="0,7,18,6" TextWrapping="Wrap" MaxWidth="520" />
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Глобальный поиск" />
                    <TextBox Width="320" Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Глобальный поиск" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="{Binding UndoStatusText}" Command="{Binding UndoCommand}" ToolTip="Отменить последнее действие, до 10 шагов назад" />
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#24292F">
                <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" Background="Transparent" BorderThickness="0" Foreground="White" Margin="0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Padding="18,10" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </DockPanel>
</Window>

